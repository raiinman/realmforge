{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realmforge.local/contracts/bridge/prepare-world-join-request-v1.schema.json",
  "title": "Realmforge Bridge PrepareWorldJoin request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "realmId",
    "realmforgeGameAccountId",
    "gateSessionId",
    "clientBuild",
    "clientSessionKeyBase64",
    "requestedAt"
  ],
  "properties": {
    "realmId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "realmforgeGameAccountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "gateSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "clientBuild": {
      "type": "integer",
      "minimum": 1
    },
    "clientPlatform": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "clientLocale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "clientSessionKeyBase64": {
      "type": "string",
      "description": "Opaque compatibility session material. For the first 40618 adapter profile this decodes to exactly 64 bytes.",
      "minLength": 1,
      "maxLength": 256
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
