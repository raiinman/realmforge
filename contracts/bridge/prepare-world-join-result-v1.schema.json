{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realmforge.local/contracts/bridge/prepare-world-join-result-v1.schema.json",
  "title": "Realmforge Bridge PrepareWorldJoin result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["joinTicket", "serverAddresses"],
  "properties": {
    "joinTicket": {
      "type": "string",
      "description": "Opaque adapter lookup token that Gate places into the client-family join response.",
      "minLength": 1,
      "maxLength": 255
    },
    "adapterSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "serverAddresses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "host", "port"],
        "properties": {
          "family": {
            "type": "string",
            "enum": ["ipv4", "ipv6", "dns"]
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
